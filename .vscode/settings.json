{
  "liveSassCompile.settings.formats": [
    {
      "format": "expanded",
      "extensionName": ".css",
      "savePath": "/assets/css",
      "savePathReplacementPairs": null
    },
    {
      "format": "compressed",
      "extensionName": ".min.css",
      "savePath": "/assets/css",
      "savePathReplacementPairs": null
    }
  ],
  "liveSassCompile.settings.generateMap": true,
  "liveServer.settings.port": 5502,
  "files.autoSave": "afterDelay",
  "liveSassCompile.settings.forceBaseDirectory": "",
  "tabnine.experimentalAutoImports": true,
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },

  "auto-close-tag.enableAutoCloseSelfClosingTag": false,
  "html.autoClosingTags": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.proseWrap": "never",
  "prettier.bracketSameLine": true,
  "javascript.autoClosingTags": false,
  "typescript.autoClosingTags": false,
  "git.autofetch": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "workbench.iconTheme": "material-icon-theme",
  "liveSassCompile.settings.autoprefix": [],
  "editor.fontSize": 16,
  "tailwindCSS.experimental.classRegex": [],
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "liveServer.settings.donotVerifyTags": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "workbench.colorTheme": "Learn with Sumit Theme - Dracula version",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.wordWrap": "on",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "settingsSync.ignoredExtensions": ["glenn2223.live-sass"],
  "editor.stickyScroll.enabled": false,
  "editor.codeActionsOnSave": {},
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "codeium.enableConfig": {
    "*": true,
    "postcss": true
  },
  "editor.minimap.enabled": false,
  "explorer.confirmDragAndDrop": false,
  "tailwindCSS.experimental.configFile": "src/scss/tailwindfile.css",
  // "tailwindCSS.experimental.configFile": "app/globals.css",
  "editor.formatOnSave": true,
  "npm.keybindingsChangedWarningShown": true,
  "editor.formatOnPaste": true,
  "explorer.confirmDelete": false,
  "json.schemas": []
}
